# ------------------------------------------------------------------------------
# LEMON CHAT — Backend Environment Configuration (.env.example)
# ------------------------------------------------------------------------------

# Application
APP_ENV=development
HOST=0.0.0.0
PORT=3000
FRONTEND_URL=http://localhost:5173
# Express trusted proxy setting used to derive req.ip (set to your proxy CIDRs in production).
TRUST_PROXY=loopback

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lemon_chat
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CONNECTION_TIMEOUT=5000

# S3 / S3-compatible storage (R2: endpoint + region auto; MinIO: force path style)
# Required in production; in dev all of these may be empty (presign returns 503).
S3_BUCKET=lemon-stories
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL_SECS=300

# Authentication & JWT (Secret must be >= 32 bytes)
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long_12345
JWT_ISSUER=lemon-chat
JWT_AUDIENCE=lemon-chat-client

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=info

# Mail / SMTP (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM="LemonChat <your_email@gmail.com>"
