# ------------------------------------------------------------------------------
# LEMON CHAT — Backend Environment Configuration (.env.example)
# ------------------------------------------------------------------------------

# Application
APP_ENV=development
HOST=0.0.0.0
PORT=3000
FRONTEND_URL=http://localhost:5173
# Express trusted proxy setting used to derive req.ip (set to your proxy CIDRs in production).
TRUST_PROXY=loopback
# Optional bearer token; when empty, the Prometheus /metrics endpoint is disabled.
METRICS_TOKEN=

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lemon_chat
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CONNECTION_TIMEOUT=5000

# S3 / Cloudflare R2 Storage (Media, Attachments, Stories)
# For Cloudflare R2:
#   - Region: auto
#   - Endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
#   - Force Path Style: false
#   - Create API Token: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens (Object Read & Write)
S3_BUCKET=lemon-chat-storage
S3_REGION=auto
S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_PRESIGN_TTL_SECS=300

# Authentication & JWT (Secret must be >= 32 bytes)
JWT_SECRET=super_secret_jwt_key_at_least_32_bytes_long_12345
JWT_ISSUER=lemon-chat
JWT_AUDIENCE=lemon-chat-client

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=info

# Mail / SMTP (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM="LemonChat <your_email@gmail.com>"
