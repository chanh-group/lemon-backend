{
  "info": {
    "_postman_id": "lemon-chat-1-1-collection",
    "name": "Lemon Chat — 1-1 Messaging (Role 3)",
    "description": "Bộ Collection kiểm thử toàn bộ tính năng Chat 1-1 cho Lemon Chat (REST & Realtime). Import vào Postman hoặc Bruno để test với 1 click.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "userA",
      "value": "01a145a1-c0ae-71c9-be18-58ff1a542e82",
      "type": "string"
    },
    {
      "key": "userB",
      "value": "01a145a1-c0ae-71c9-be18-5d1f20547e78",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "01a145a1-c34b-75dd-ba87-8a49ea3f1025",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Mở phòng chat 1-1 (User A -> User B)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.id) {",
              "    pm.collectionVariables.set('conversationId', res.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userA}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetUserId\": \"{{userB}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/conversations/direct",
          "host": ["{{baseUrl}}"],
          "path": ["conversations", "direct"]
        }
      }
    },
    {
      "name": "2. User A gửi tin nhắn",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.data && res.data.id) {",
              "    pm.collectionVariables.set('messageId', res.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userA}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Chào bạn Beta, test gửi tin nhắn từ Postman!\",\n  \"kind\": \"TEXT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages",
          "host": ["{{baseUrl}}"],
          "path": ["conversations", "{{conversationId}}", "messages"]
        }
      }
    },
    {
      "name": "3. User B xem hộp thư Inbox",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userB}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/conversations",
          "host": ["{{baseUrl}}"],
          "path": ["conversations"]
        }
      }
    },
    {
      "name": "4. User B xem lịch sử tin nhắn trong phòng",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userB}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages?limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["conversations", "{{conversationId}}", "messages"],
          "query": [
            { "key": "limit", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "5. User B đánh dấu đã đọc",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userB}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lastReadMessageId\": \"{{messageId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/conversations/{{conversationId}}/read",
          "host": ["{{baseUrl}}"],
          "path": ["conversations", "{{conversationId}}", "read"]
        }
      }
    },
    {
      "name": "6. User A chỉnh sửa tin nhắn",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userA}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Nội dung tin nhắn đã được User A sửa lại!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/messages/{{messageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["messages", "{{messageId}}"]
        }
      }
    },
    {
      "name": "7. User A thu hồi tin nhắn",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "x-user-id", "value": "{{userA}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/messages/{{messageId}}",
          "host": ["{{baseUrl}}"],
          "path": ["messages", "{{messageId}}"]
        }
      }
    },
    {
      "name": "8. Kiểm tra chi tiết cuộc hội thoại",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userA}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/conversations/{{conversationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["conversations", "{{conversationId}}"]
        }
      }
    }
  ]
}

